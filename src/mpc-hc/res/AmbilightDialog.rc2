    CONTROL "Top",IDC_AMBILIGHT_TOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,272,60,12
    CONTROL "Right",IDC_AMBILIGHT_RIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,272,60,12
    CONTROL "Bottom",IDC_AMBILIGHT_BOTTOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,272,65,12
    CONTROL "Left",IDC_AMBILIGHT_LEFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,240,272,60,12
    LTEXT "Live preview - changes are saved automatically",IDC_AMBILIGHT_STATUS,10,291,295,12
