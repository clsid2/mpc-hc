// Native modeless panel, opened next to the volume controls.
IDD_AMBILIGHT DIALOGEX 0, 0, 316, 334
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Ambilight"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL "Enable ambient light",IDC_AMBILIGHT_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,10,145,12
    LTEXT "Ambient light",-1,10,31,130,11
    LTEXT "",IDC_AMBILIGHT_LABEL+0,10,49,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+0,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,45,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+0,263,46,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+1,10,69,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+1,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,65,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+1,263,66,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+2,10,89,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+2,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,85,155,17
