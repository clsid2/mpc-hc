    EDITTEXT IDC_AMBILIGHT_VALUE+3,263,106,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+4,10,129,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+4,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,125,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+4,263,126,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+5,10,149,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+5,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,145,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+5,263,146,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+6,10,169,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+6,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,165,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+6,263,166,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+7,10,189,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+7,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,185,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+7,263,186,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+8,10,209,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+8,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,205,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+8,263,206,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+9,10,229,85,10
    CONTROL "",IDC_AMBILIGHT_SLIDER+9,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,97,225,155,17
    EDITTEXT IDC_AMBILIGHT_VALUE+9,263,226,42,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "",IDC_AMBILIGHT_LABEL+10,10,249,85,10
