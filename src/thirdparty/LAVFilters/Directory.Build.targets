<?xml version="1.0" encoding="utf-8"?>
<!--
  Picked up by MSBuild for every project below this directory, including the ones
  inside the LAV Filters submodule (see Directory.Build.props).

  DSUtilLite's pre-build step runs LAV's common\genversion.bat, which needs a bash
  under %MPCHC_MSYS% to run version.sh. msvc\genversion.cmd does the same job in
  plain cmd, so a build needs no shell at all. This item definition comes after the
  project's own, so it wins.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='DSUtilLite'">
    <PreBuildEvent>
      <Command>call "$(MSBuildThisFileDirectory)msvc\genversion.cmd"</Command>
      <Message>Generating LAV version_rev.h</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>
</Project>
