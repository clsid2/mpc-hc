  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <!-- NotSet: ffmpeg is never built with UNICODE/_UNICODE (the old ffmpeg-msvc.mak did not define them either) -->
    <CharacterSet>NotSet</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- source tree = LAV's ffmpeg fork; config = this directory (config.h/config.asm/lists, kept by configure_ffmpeg-min.sh) -->
    <!-- *Root properties may be overridden on the command line (no trailing slash needed); the derived ones always end in a backslash -->
    <FFmpegSrcRoot Condition="'$(FFmpegSrcRoot)'==''">$(MSBuildThisFileDirectory)..\LAVFilters\src\ffmpeg</FFmpegSrcRoot>
    <FFmpegSrc>$([MSBuild]::EnsureTrailingSlash('$(FFmpegSrcRoot)'))</FFmpegSrc>
    <FFmpegCfgRoot Condition="'$(FFmpegCfgRoot)'==''">$(MSBuildThisFileDirectory)</FFmpegCfgRoot>
    <FFmpegCfg>$([MSBuild]::EnsureTrailingSlash('$(FFmpegCfgRoot)'))</FFmpegCfg>
    <SoxrSrcRoot Condition="'$(SoxrSrcRoot)'==''">$(MSBuildThisFileDirectory)..\soxr\libsoxr\src</SoxrSrcRoot>
    <SoxrSrc>$([MSBuild]::EnsureTrailingSlash('$(SoxrSrcRoot)'))</SoxrSrc>
    <MpcBinRoot Condition="'$(MpcBinRoot)'==''">$(MSBuildThisFileDirectory)..\..\..\bin</MpcBinRoot>
    <MpcBin>$([MSBuild]::EnsureTrailingSlash('$(MpcBinRoot)'))</MpcBin>
    <LavArch Condition="'$(Platform)'=='x64'">64</LavArch>
    <LavArch Condition="'$(Platform)'=='Win32'">32</LavArch>
    <OutDir>$(MpcBin)lib\$(Configuration)_$(Platform)\</OutDir>
    <IntDir>$(MpcBin)obj\$(Configuration)_$(Platform)\ffmpeg\</IntDir>
    <TargetName>ffmpeg</TargetName>
    <NasmFlags Condition="'$(Platform)'=='x64'">-f win64 -DWIN64=1 -DPIC</NasmFlags>
    <NasmFlags Condition="'$(Platform)'=='Win32'">-f win32 -DWIN32=1 -DPREFIX</NasmFlags>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <CompileAs>CompileAsC</CompileAs>
      <AdditionalIncludeDirectories>$(FFmpegCfg);$(FFmpegSrc);$(FFmpegSrc)compat\atomics\win32;$(SoxrSrc);$(MSBuildThisFileDirectory)..\LAVFilters\src\thirdparty\$(LavArch)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_ISOC99_SOURCE;_FILE_OFFSET_BITS=64;_LARGEFILE_SOURCE;_USE_MATH_DEFINES;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;ZLIB_CONST;HAVE_AV_CONFIG_H;_WIN32_WINNT=0x0600;WINVER=0x0600;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">WIN64=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='Win32'">WIN32=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>-GS- -wd4018 -wd4146 -wd4244 -wd4305 -wd4554 -utf-8 %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization>
      <OmitFramePointers Condition="'$(Platform)'=='Win32'">false</OmitFramePointers>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <SDLCheck>false</SDLCheck>
      <ControlFlowGuard>false</ControlFlowGuard>
      <DebugInformationFormat>None</DebugInformationFormat>
      <DebugInformationFormat Condition="'$(Configuration)'=='Debug'">OldStyle</DebugInformationFormat>
      <AdditionalOptions Condition="'$(Configuration)'=='Debug'">-Zo %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Lib>
      <IgnoreSpecificDefaultLibraries>libcmt;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Lib>
  </ItemDefinitionGroup>
