# LLM Configuration
LLM_PROVIDER=openai          # "openai" or "anthropic"
LLM_MODEL=gpt-4o             # or "claude-sonnet-4-6"
LLM_TEMPERATURE=0.1

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Jetbuilt API
JETBUILT_API_TOKEN=your-jetbuilt-token
JETBUILT_BASE_URL=https://app.jetbuilt.com/api

# XTEN-AV XAVIA API
XAVIA_API_KEY=your-xavia-key
XAVIA_BASE_URL=https://api.xten-av.com/v1

# Gmail API (OAuth 2.0)
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_TOKEN_JSON=token.json
GMAIL_SENDER_EMAIL=deals@yourcompany.com
GMAIL_SENDER_NAME=Your Name

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Application
MOCK_MODE=false
LOG_LEVEL=INFO
